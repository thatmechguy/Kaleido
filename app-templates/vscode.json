  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "{{ colors.outline.default.hex }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.separator"
      ],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Booleans",
      "scope": ["constant.boolean", "constant.language.boolean"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.require"
      ],
      "settings": { "foreground": "{{ colors.primary.default.hex }}" }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "{{ colors.tertiary_container.default.hex }}" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "{{ colors.on_surface.default.hex }}" }
    },
    {
      "name": "Special variables",
      "scope": ["variable.language", "variable.parameter"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Properties and attributes",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "entity.name.tag"
      ],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "{{ colors.primary.default.hex }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "{{ colors.primary.default.hex }}" }
    },
    {
      "name": "Markup inserted",
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "{{ colors.tertiary.default.hex }}" }
    },
    {
      "name": "Markup deleted",
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "{{ colors.error.default.hex }}" }
    },
    {
      "name": "Markup changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Markup list and quote",
      "scope": ["markup.list", "markup.quote"],
      "settings": { "foreground": "{{ colors.on_surface_variant.default.hex }}" }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "punctuation.definition.string"],
      "settings": { "foreground": "{{ colors.secondary_container.default.hex }}" }
    },
    {
      "name": "Regexp",
      "scope": ["constant.regexp", "string.regexp"],
      "settings": { "foreground": "{{ colors.error.default.hex }}" }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": { "foreground": "{{ colors.secondary.default.hex }}" }
    },
    {
      "name": "Invalid / illegal",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "{{ colors.error.default.hex }}",
        "background": "{{ colors.error_container.default.hex }}"
      }
    }
  ]
}
